# Copy to BACKEND/.env. Values in this file are deployment configuration, not browser variables.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/omnitrix.db
# PostgreSQL alternative after installing .[postgres]: postgresql+psycopg://USER:PASSWORD@HOST:5432/omnitrix
DATA_DIR=./data
AUTO_CREATE_SCHEMA=true
ORGANIZATION=OMNITRIX
ALLOWED_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]
ALLOWED_HOSTS=["127.0.0.1","localhost","testserver"]
# Production: ENVIRONMENT=production, COOKIE_SECURE=true, explicit HTTPS gateway origin/hostname above.
COOKIE_SECURE=false
SESSION_HOURS=8
LOGIN_ATTEMPTS=8
LOGIN_WINDOW_SECONDS=900

# Prefer: python -m app.cli create-admin --email YOUR_EMAIL (prompts securely).
# Optional one-time unattended provisioning. Never use a shared demo password.
BOOTSTRAP_ADMIN_EMAIL=admin@omnitrix.local
BOOTSTRAP_ADMIN_PASSWORD=

# Control plane / small 2B orchestrator. OpenAI-compatible base URL ending in /v1.
ORCHESTRATOR_BASE_URL=
ORCHESTRATOR_API_KEY=
ORCHESTRATOR_MODEL=
ORCHESTRATOR_MAX_TOKENS=96

# T1 / inference node 1: text and chat (FAST registry group).
TEXT_BASE_URL=
TEXT_API_KEY=
TEXT_MODEL=
TEXT_FALLBACK_MODEL=

# V1 / inference node 2: vision and OCR (VISION registry group).
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_FALLBACK_MODEL=

# C1 / inference node 3: code and reasoning (MASTER registry group).
CODE_BASE_URL=
CODE_API_KEY=
CODE_MODEL=
CODE_FALLBACK_MODEL=

# Librarian embedding service: /v1/embeddings. Dimensions MUST match the selected model.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_REGISTRY_ID=librarian-1
EMBEDDING_DIMENSIONS=1024
RAG_MODE=semantic
# sql: persists vectors in local SQL and computes cosine similarity; qdrant: dedicated vector DB.
VECTOR_STORE=sql
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=omnitrix
RAG_TOP_K=5
# Explicit lexical development mode works without embeddings: RAG_MODE=lexical.
# Never labels keyword retrieval as semantic search.

# Optional extra registry-node bindings, keyed by the ID returned by POST /nodes.
# {"node-ID":{"base_url":"http://INTERNAL_HOST:PORT/v1","api_key":"...","groups":["FAST"],"models":{"fast-1":"served-model-alias"}}}
EXTRA_WORKERS_JSON={}
PROVIDER_TIMEOUT_SECONDS=120
PROVIDER_HEALTH_TIMEOUT_SECONDS=5
PROVIDER_RESPONSE_MAX_MB=8
PROVIDER_VERIFY_TLS=true

# Opt in only direct Ollama endpoints. Same /v1 URL as each role binding.
# Native /api/chat, /api/embed, /api/ps and /api/generate must be reachable.
# Example: ["http://127.0.0.1:11434/v1","https://YOUR-MAC/v1"]
OLLAMA_MANAGED_BASE_URLS=[]
OLLAMA_PIN_ORCHESTRATOR=true
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_CLEANUP_TIMEOUT_SECONDS=15

WORKER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_POLL_SECONDS=1
WORKER_LEASE_SECONDS=90
TASK_TIMEOUT_SECONDS=300
TOKEN_RESERVATION=16384
MAX_OUTPUT_TOKENS=2048
TEXT_MAX_OUTPUT_TOKENS=512
CODE_MAX_OUTPUT_TOKENS=1024
TEXT_REASONING_EFFORT=none
CODE_REASONING_EFFORT=
MAX_HISTORY_CHARS=6000
MAX_CONTEXT_CHARS=10000
MAX_UPLOAD_MB=20
MAX_DOCUMENT_PAGES=40
MAX_DOCUMENT_CHARS=200000
MAX_OCR_PAGES=8
DAILY_TOKEN_LIMIT=2000000
MONTHLY_TOKEN_LIMIT=40000000
USER_DAILY_TOKEN_LIMIT=100000
USER_MONTHLY_TOKEN_LIMIT=2000000
RETENTION_DAYS=365
